# Copy to `.env` (`just up` does it for you on first run) and change the secrets.
# `.env` is ignored by Git. Never commit real keys.

# Gateway of llmops-gateway (`just gateway-up` there). The app calls every model through it.
GATEWAY_URL=http://localhost:4000
# Virtual key of the f1 team: TEAM_KEY_F1 in llmops-gateway's .env. Never the gateway's master key.
GATEWAY_API_KEY=sk-local-dev-team-f1

# Langfuse of llmops-gateway: the f1 team's project, where the app traces the steps of its retrieval pipeline
# (the gateway traces the model calls there too). LANGFUSE_SECRET_KEY_F1 in llmops-gateway's .env. Leave the keys
# empty to turn the app's tracing off.
LANGFUSE_HOST=http://localhost:3100
LANGFUSE_PUBLIC_KEY=pk-lf-f1
LANGFUSE_SECRET_KEY=sk-lf-f1-local-dev

# Qdrant (index of the FIA corpus): host port, bound to 127.0.0.1 only, and the URL the app uses.
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333

# PostgreSQL: checkpoints of the agent and log of the human decisions. Host port bound to 127.0.0.1 only;
# not 5432, which a local PostgreSQL install usually holds, nor 5433, held by LabbTech Auth's database.
POSTGRES_USER=f1
POSTGRES_PASSWORD=local-dev-password
POSTGRES_DB=f1
POSTGRES_PORT=5435

# Race data lake: Parquet files in the S3 store of compose.yaml (SeaweedFS), filled by `just ingest`.
# LAKE_URI can also be a local folder (e.g. data/lake), then the S3 settings are ignored.
LAKE_URI=s3://race-data
LAKE_S3_PORT=8334
LAKE_S3_ENDPOINT=http://localhost:8334
LAKE_S3_ACCESS_KEY=f1
LAKE_S3_SECRET_KEY=local-dev-s3-secret
# HTTP cache of FastF1, so a rerun does not download the data again.
INGEST_FASTF1_CACHE=.cache/fastf1

# Host ports of the API and the front served by `just up`, and of `just api` and `just web-dev`, which reload on
# every change. The front reaches the API on API_URL (default: the API of `just up`).
API_PORT=8000
WEB_PORT=3000
API_DEV_PORT=8001
WEB_DEV_PORT=3001

# Accounts (LAB-192, docs/web.md): LabbTech Auth, the SSO of the LabbTech apps (`just auth-up` in
# labbtech-universe: the sign-in pages on 3002, its API on 3003). Empty, the API runs open: every caller is the local
# analyst, and the front shows no sign-in. To try accounts locally, uncomment, then put your account id in
# AUTH_ANALYSTS (the `sub` of GET /me, comma-separated).
# AUTH_JWKS_URI=http://localhost:3003/.well-known/jwks.json
# AUTH_JWT_ISSUER=http://localhost:3003
# AUTH_JWT_AUDIENCE=labbtech
# AUTH_ANALYSTS=
# The front: the SSO's API, called by its server to renew a session; its sign-in pages; and this site's own address,
# where the SSO sends the visitor back.
# AUTH_API_URL=http://localhost:3003
# AUTH_APP_URL=http://localhost:3002
# APP_URL=http://localhost:3001

# Retrieval pipeline (core.retrieval.pipeline.PipelineConfig, prefix RAG_): models of each step and switches of the
# ablation, e.g. RAG_RERANK=false. Rewriting runs on the local chat-medium; answers and their check on chat-pro
# (Scaleway, about a tenth of a cent per question): set both to chat-medium to stay local, at the cost of more
# "not found" answers.
RAG_REWRITE_MODEL=chat-medium
RAG_ANSWER_MODEL=chat-pro
RAG_VERIFY_MODEL=chat-pro

# Reference system of LAB-147 (core.baseline.BaselineConfig, prefix BASELINE_): chat-pro like the pipeline, so that
# a comparison measures the orchestration, not the model. chat-medium iterates locally for free.
BASELINE_MODEL=chat-pro

# Debrief agent (LAB-151, docs/agent.md): the model of each node that calls one, and the limits of a request.
# chat-medium does not choose tools in a structured answer (LAB-150): keep chat-pro.
AGENT_PARSE_MODEL=chat-pro
AGENT_PLAN_MODEL=chat-pro
AGENT_DRAFT_MODEL=chat-pro
AGENT_MAX_STEPS=40
AGENT_MAX_LLM_CALLS=80
AGENT_MAX_TOKENS=300000

# Job queue of llmops-platform, for `just season-jobs`: the RabbitMQ of llmops-gateway's compose stack locally
# (RABBITMQ_USER and RABBITMQ_PASSWORD there), the platform's job-queue secret on the cluster.
JOBS_AMQP_URL=amqp://jobs:local-dev-password@localhost:5673/

# Key of the evaluation CI's data (`just eval-data-publish`, docs/evaluation.md): the repository secret EVAL_DATA_KEY.
# Only whoever publishes the data needs it.
EVAL_DATA_KEY=
